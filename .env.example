# Server Port
PORT=3000

# Environment Mode: development | test | production
NODE_ENV=development

# PostgreSQL Connection String (Supabase Connection Pooler URL or local database)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# JWT Authentication Secrets (Use high-entropy strings for production)
JWT_ACCESS_SECRET="your_jwt_access_secret_key_minimum_32_characters_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_minimum_32_characters_here"

# Optional: Frontend Client Origin for CORS in production
# CLIENT_URL="http://localhost:5173"