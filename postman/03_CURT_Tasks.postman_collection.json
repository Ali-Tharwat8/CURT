{
  "info": {
    "_postman_id": "curt-tasks-api-collection-v1",
    "name": "03 - CURT Tasks Collection",
    "description": "Comprehensive, production-grade test suite for Task Management, Assignment Integrity, and Level 3 RBAC in Cairo University Racing Team (CURT) ERP.\n\nVerifies that:\n1. Tasks can only be assigned to active project members (400 Bad Request on outsiders).\n2. Regular members can view tasks and ONLY update the status of tasks assigned to them.\n3. Regular members cannot edit metadata or delete tasks (403 Forbidden).\n4. Outsiders cannot view project tasks (403 Forbidden).\n5. Full pagination and filtering engine.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
