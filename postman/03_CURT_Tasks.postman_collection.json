    {
      "name": "02 - Task Creation & Assignment Integrity",
      "description": "Tests task creation and validates that only active project members can be assigned.",
      "item": [
        {
          "name": "05 - Assign Task to Non-Member Outsider (Negative - 400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Server rejects assignment to non-member outsider\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "    pm.expect(jsonData.error).to.eql(\"Bad Request\");",
                  "    pm.expect(jsonData.message).to.eql(\"Assignee must be an active member of this project\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Illegal Assignment to Outsider\",\n    \"description\": \"Attempting to assign task to non-member Salma\",\n    \"priority\": \"High\",\n    \"assignedTo\": \"{{outsiderUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks"
              ]
            },
            "description": "Asserts assignment integrity prevents assigning tasks to non-members."
          },
          "response": []
        },
