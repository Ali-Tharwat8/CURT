                  "    pm.expect(jsonData.data.id).to.eql(pm.collectionVariables.get(\"taskId\"));",
                  "    pm.expect(jsonData.data).to.have.property(\"assignee\");",
                  "    pm.expect(jsonData.data).to.have.property(\"userRole\");",
                  "});"
