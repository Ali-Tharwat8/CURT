    {
      "name": "03 - Task Query Engine & Pagination",
      "description": "Tests filtering by status, priority, assignee, search, and pagination metadata.",
      "item": [
        {
          "name": "08 - List Project Tasks with Filters & Pagination (GET /api/projects/:id/tasks)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response contains task array and pagination envelope\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(Array.isArray(jsonData.data)).to.be.true;",
                  "    pm.expect(jsonData.pagination).to.have.property(\"page\");",
                  "    pm.expect(jsonData.pagination).to.have.property(\"limit\");",
                  "    pm.expect(jsonData.pagination).to.have.property(\"total\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{memberToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks?status=To Do&priority=High&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects",
                "{{projectId}}",
                "tasks"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "To Do"
                },
                {
                  "key": "priority",
                  "value": "High"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Filters project tasks by status and priority with pagination."
          },
          "response": []
        },
        {
          "name": "09 - Get Task Details by ID (GET /api/tasks/:id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
