    {
      "name": "02 - Project CRUD Operations",
      "description": "Core project management endpoints: creation, retrieval, listing with pagination, and updating metadata.",
      "item": [
        {
          "name": "06 - Create Project (Owner)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Auto-auth fallback if ownerToken is missing",
                  "if (!pm.collectionVariables.get(\"ownerToken\")) {",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get(\"baseUrl\") + \"/api/auth/login\",",
                  "        method: \"POST\",",
                  "        header: { \"Content-Type\": \"application/json\" },",
                  "        body: {",
                  "            mode: \"raw\",",
                  "            raw: JSON.stringify({",
                  "                identifier: pm.collectionVariables.get(\"ownerEmail\") || \"karim@curt.racing\",",
                  "                password: pm.collectionVariables.get(\"ownerPassword\") || \"CurtPassword123!\"",
                  "            })",
                  "        }",
                  "    }, function (err, res) {",
                  "        if (!err && res.code === 200) {",
                  "            const json = res.json();",
                  "            pm.collectionVariables.set(\"ownerToken\", json.data.accessToken);",
                  "            pm.collectionVariables.set(\"ownerUserId\", json.data.user.id);",
                  "        }",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Project created and ID saved to collection variables\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property(\"id\");",
                  "    pm.expect(jsonData.data.name).to.eql(pm.collectionVariables.get(\"projectName\"));",
                  "    pm.collectionVariables.set(\"projectId\", jsonData.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ownerToken}}",
                  "type": "string"
                }
              ]
