    {
      "name": "01 - Authentication & Setup",
      "description": "Log in with seeded team engineers or register fresh accounts. Sets ownerToken, memberToken, and outsiderToken automatically.",
      "item": [
        {
          "name": "01 - Login as Seeded Project Owner (Karim Amr)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Owner credentials extracted and saved to collection variables\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property(\"accessToken\");",
                  "    pm.collectionVariables.set(\"ownerToken\", jsonData.data.accessToken);",
                  "    pm.collectionVariables.set(\"ownerUserId\", jsonData.data.user.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"identifier\": \"{{ownerEmail}}\",\n    \"password\": \"{{ownerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Logs in as seeded Aerodynamics Lead (Karim Amr) and saves ownerToken."
          },
          "response": []
        },
